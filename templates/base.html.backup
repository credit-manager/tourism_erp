{% set lang = LANG(request) if LANG is defined else 'ar' %}
<!DOCTYPE html>
<html lang="{{ lang }}" dir="{{ 'rtl' if lang == 'ar' else 'ltr' }}">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">

  <title>{{ page_title or "Tourism ERP" }}</title>

  <script src="https://cdn.tailwindcss.com"></script>
  <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">

  <style>
    :root {
      --pro-bg: #f4f8f5;
      --pro-card: #ffffff;
      --pro-border: #e3ebe5;
      --pro-text: #172033;
      --pro-muted: #6f7d90;
      --pro-green: #20b874;
      --pro-green-dark: #11885a;
      --pro-green-soft: #edf9f3;
      --pro-lime: #d8f06a;
      --pro-yellow: #f7c948;
      --pro-red: #ef5b6c;
      --pro-blue: #4f9cf9;
      --pro-purple: #8b7cf6;
      --pro-shadow: 0 10px 30px rgba(15, 23, 42, 0.05);
      --pro-shadow-hover: 0 16px 38px rgba(15, 23, 42, 0.08);
      --sidebar-open-width: 225px;
      --sidebar-close-width: 82px;
    }

    * { box-sizing: border-box; }

    html, body { overflow-x: hidden; }

    body {
      margin: 0;
      background:
        radial-gradient(circle at top right, rgba(216, 240, 106, 0.10), transparent 28%),
        radial-gradient(circle at bottom left, rgba(32, 184, 116, 0.08), transparent 32%),
        var(--pro-bg);
      color: var(--pro-text);
      font-family: "Cairo", "Inter", "Segoe UI", Tahoma, Arial, sans-serif;
      min-height: 100vh;
      direction: inherit;
    }

    a { text-decoration: none; }

    .app-shell {
      display: grid;
      grid-template-columns: var(--sidebar-open-width) 1fr;
      min-height: 100vh;
      direction: ltr;
      transition: grid-template-columns 0.22s ease;
    }

    html[dir="rtl"] .app-shell {
      grid-template-columns: 1fr var(--sidebar-open-width);
    }

    html[dir="ltr"] .app-shell.sidebar-collapsed {
      grid-template-columns: var(--sidebar-close-width) 1fr;
    }

    html[dir="rtl"] .app-shell.sidebar-collapsed {
      grid-template-columns: 1fr var(--sidebar-close-width);
    }

    .pro-sidebar {
      background:
        radial-gradient(circle at top left, rgba(216,240,106,.13), transparent 45%),
        radial-gradient(circle at bottom right, rgba(32,184,116,.09), transparent 40%),
        rgba(255,255,255,.97);
      backdrop-filter: blur(20px);
      border-inline-end: 1.5px solid rgba(210,235,190,.8);
      padding: 18px 14px 22px;
      position: sticky;
      top: 0;
      height: 100vh;
      overflow-y: auto;
      overflow-x: hidden;
      direction: inherit;
      scrollbar-width: none;
      -ms-overflow-style: none;
      box-shadow: 4px 0 24px rgba(32,184,116,.06), 0 0 0 1px rgba(210,235,190,.5);
      transition: padding 0.22s ease;
    }

    .pro-sidebar::-webkit-scrollbar { display: none; }

    html[dir="rtl"] .pro-sidebar {
      grid-column: 2;
      border-inline-end: 0;
      border-inline-start: 1px solid var(--pro-border);
    }

    .pro-main {
      min-width: 0;
      direction: inherit;
    }

    html[dir="rtl"] .pro-main {
      grid-column: 1;
      grid-row: 1;
      direction: rtl;
    }

    html[dir="rtl"] .pro-sidebar {
      direction: rtl;
    }

    html[dir="ltr"] .pro-main {
      direction: ltr;
    }

    .sidebar-toggle-wrap {
      position: sticky;
      top: 0;
      z-index: 80;
      display: flex;
      justify-content: flex-start;
      align-items: center;
      padding: 0 0 12px;
      margin-bottom: 2px;
      background: linear-gradient(
        to bottom,
        rgba(255, 255, 255, 0.96) 0%,
        rgba(255, 255, 255, 0.92) 70%,
        rgba(255, 255, 255, 0) 100%
      );
    }

    html[dir="ltr"] .sidebar-toggle-wrap {
      justify-content: flex-end;
    }

    .sidebar-float-toggle {
      width: 38px;
      height: 38px;
      border: 1px solid var(--pro-border);
      border-radius: 999px;
      background: #ffffff;
      color: var(--pro-green-dark);
      display: inline-flex;
      align-items: center;
      justify-content: center;
      box-shadow: 0 10px 22px rgba(15, 23, 42, 0.10);
      cursor: pointer;
      transition: 0.18s ease;
      flex: 0 0 auto;
    }

    .sidebar-float-toggle:hover {
      background: var(--pro-green-soft);
      transform: scale(1.04);
    }

    .app-shell.sidebar-collapsed .pro-sidebar {
      padding-inline: 12px;
    }

    .app-shell.sidebar-collapsed .sidebar-toggle-wrap {
      justify-content: center;
    }

    .app-shell.sidebar-collapsed .brand-box {
      justify-content: center;
      padding-inline: 0;
    }

    .app-shell.sidebar-collapsed .brand-box > div:last-child,
    .app-shell.sidebar-collapsed .nav-item span,
    .app-shell.sidebar-collapsed .sidebar-footer {
      display: none;
    }

    .app-shell.sidebar-collapsed .nav-item {
      justify-content: center;
      padding: 11px;
    }

    .app-shell.sidebar-collapsed .nav-item i {
      width: auto;
      font-size: 18px;
    }

    .brand-box {
      display: flex;
      align-items: center;
      gap: 11px;
      padding: 0 6px 16px;
      margin-bottom: 12px;
      border-bottom: 1.5px solid #dff0c8;
    }

    .brand-icon {
      width: 44px;
      height: 44px;
      border-radius: 16px;
      background: linear-gradient(135deg, #a3d96b, #21bd7a);
      color: #0f3d2c;
      display: inline-flex;
      align-items: center;
      justify-content: center;
      font-size: 22px;
      box-shadow: 0 10px 22px rgba(103,197,80,.28), 0 2px 6px rgba(32,184,116,.18);
      flex: 0 0 auto;
    }

    .brand-title {
      font-size: 20px;
      font-weight: 900;
      background: linear-gradient(135deg, #172033, #0f5f3a);
      -webkit-background-clip: text;
      -webkit-text-fill-color: transparent;
      background-clip: text;
      line-height: 1;
      white-space: nowrap;
    }

    .brand-sub {
      margin-top: 4px;
      font-size: 10.5px;
      color: var(--pro-muted);
      font-weight: 700;
      white-space: nowrap;
    }

    .nav-section {
      display: flex;
      flex-direction: column;
      gap: 4px;
    }

    .nav-item {
      display: flex;
      align-items: center;
      gap: 11px;
      min-height: 44px;
      padding: 10px 13px;
      border-radius: 14px;
      color: #4b5563;
      font-size: 13px;
      font-weight: 800;
      transition: all 0.18s ease;
      white-space: nowrap;
      position: relative;
      border: 1.5px solid transparent;
    }

    .nav-item i {
      width: 22px;
      text-align: center;
      font-size: 16px;
      color: #9ca3af;
      transition: 0.16s ease;
      flex: 0 0 auto;
    }

    .nav-item:hover {
      background: linear-gradient(135deg, #f0fce4, #f5fdf0);
      color: var(--pro-green-dark);
      border-color: #d4f0b0;
      transform: translateX(-2px);
      box-shadow: 0 4px 14px rgba(32,184,116,.10);
    }

    html[dir="ltr"] .nav-item:hover {
      transform: translateX(2px);
    }

    .nav-item:hover i { color: var(--pro-green); }

    .nav-item.active {
      background: linear-gradient(135deg, #d8f56a22, #d0f5e822);
      color: #0c5a3d;
      border-color: #b8e88a;
      box-shadow: 0 6px 18px rgba(32,184,116,.14), inset 0 1px 0 rgba(255,255,255,.8);
    }

    .nav-item.active i {
      color: var(--pro-green-dark);
    }

    /* lime accent bar on active item */
    .nav-item.active::before {
      content: "";
      position: absolute;
      inset-inline-end: 0;
      top: 20%;
      height: 60%;
      width: 3.5px;
      border-radius: 999px;
      background: linear-gradient(180deg, var(--pro-lime), var(--pro-green));
    }

    html[dir="ltr"] .nav-item.active::before {
      inset-inline-end: auto;
      inset-inline-start: 0;
    }

    .sidebar-footer {
      margin-top: 18px;
      padding: 14px 16px;
      border-radius: 18px;
      background: linear-gradient(135deg, #f0fce4, #f8fff3);
      border: 1.5px solid #c8e89a;
      color: var(--pro-text);
      box-shadow: 0 4px 16px rgba(32,184,116,.08);
    }

    .sidebar-footer strong {
      display: block;
      font-size: 13px;
      font-weight: 900;
    }

    .sidebar-footer span {
      display: block;
      margin-top: 5px;
      font-size: 11px;
      color: var(--pro-muted);
      line-height: 1.6;
    }

    .topbar {
      height: 80px;
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 18px;
      padding: 18px 30px;
      position: sticky;
      top: 0;
      z-index: 40;
      background: rgba(244, 248, 245, 0.88);
      backdrop-filter: blur(16px);
      border-bottom: 1px solid #e8eee9;
    }

    .top-left,
    .top-right {
      display: flex;
      align-items: center;
      gap: 12px;
      min-width: 0;
    }

    .top-left { order: 1; }
    .top-right { order: 2; margin-inline-start: auto; }

    /* RTL header: swap so date goes RIGHT, icons go LEFT */
    html[dir="rtl"] .top-left { order: 2; margin-inline-start: auto; margin-inline-end: 0; }
    html[dir="rtl"] .top-right { order: 1; margin-inline-start: 0; }

    .page-date {
      min-height: 38px;
      padding: 9px 13px;
      border-radius: 14px;
      background: rgba(255, 255, 255, 0.82);
      border: 1px solid var(--pro-border);
      color: var(--pro-muted);
      font-size: 12px;
      font-weight: 800;
      white-space: nowrap;
      box-shadow: 0 6px 18px rgba(15, 23, 42, 0.035);
    }

    .lang-switch {
      display: inline-flex;
      align-items: center;
      gap: 4px;
      padding: 5px;
      border-radius: 999px;
      background: rgba(255, 255, 255, 0.88);
      border: 1px solid var(--pro-border);
      box-shadow: 0 6px 18px rgba(15, 23, 42, 0.035);
    }

    .lang-switch a {
      padding: 7px 12px;
      border-radius: 999px;
      font-size: 11px;
      font-weight: 900;
      color: var(--pro-muted);
    }

    .lang-switch a.active {
      background: var(--pro-lime);
      color: #1f2937;
    }

    .user-chip {
      display: flex;
      align-items: center;
      gap: 10px;
      padding: 8px 12px;
      border-radius: 999px;
      background: rgba(255, 255, 255, 0.88);
      border: 1px solid var(--pro-border);
      min-width: 0;
      box-shadow: 0 6px 18px rgba(15, 23, 42, 0.035);
    }

    .user-avatar {
      width: 36px;
      height: 36px;
      border-radius: 50%;
      background: linear-gradient(135deg, var(--pro-green), var(--pro-lime));
      color: #0f3d2c;
      display: inline-flex;
      align-items: center;
      justify-content: center;
      font-weight: 900;
      flex: 0 0 auto;
    }

    .user-info { min-width: 0; }

    .user-name {
      font-size: 12px;
      font-weight: 900;
      color: var(--pro-text);
      max-width: 130px;
      overflow: hidden;
      text-overflow: ellipsis;
      white-space: nowrap;
    }

    .user-role {
      font-size: 10px;
      color: var(--pro-muted);
      margin-top: 2px;
    }

    .logout-btn {
      width: 38px;
      height: 38px;
      border-radius: 14px;
      display: inline-flex;
      align-items: center;
      justify-content: center;
      background: #ffffff;
      border: 1px solid var(--pro-border);
      color: var(--pro-muted);
      transition: 0.16s ease;
      box-shadow: 0 6px 18px rgba(15, 23, 42, 0.035);
    }

    .logout-btn:hover {
      color: var(--pro-red);
      background: #fff5f6;
    }

    .content-wrap {
      padding: 28px 30px 38px;
    }

    .page-title-row {
      display: flex;
      align-items: flex-end;
      justify-content: space-between;
      gap: 16px;
      margin-bottom: 20px;
    }

    .page-title-row h1,
    .content-wrap > h1:first-child {
      font-size: 28px;
      font-weight: 950;
      color: var(--pro-text);
      margin: 0 0 4px;
      letter-spacing: -0.4px;
    }

    .card,
    .bg-white,
    .stats-card,
    .dashboard-card {
      border-radius: 24px !important;
      border: 1px solid var(--pro-border) !important;
      box-shadow: var(--pro-shadow) !important;
      transition: 0.18s ease;
    }

    .card:hover,
    .bg-white:hover,
    .stats-card:hover,
    .dashboard-card:hover {
      box-shadow: var(--pro-shadow-hover) !important;
    }

    .card h2,
    .card h3,
    .bg-white h2,
    .bg-white h3 {
      color: var(--pro-text);
      font-weight: 900;
    }

    table {
      border-collapse: separate !important;
      border-spacing: 0 !important;
      background: transparent;
    }

    thead th {
      background: #f8fcfa !important;
      color: #708092 !important;
      font-size: 12px !important;
      font-weight: 900 !important;
      border-bottom: 1px solid var(--pro-border) !important;
      padding-top: 14px !important;
      padding-bottom: 14px !important;
    }

    tbody td {
      border-bottom: 1px solid #eef2f4 !important;
      padding-top: 14px !important;
      padding-bottom: 14px !important;
      font-size: 13px;
    }

    tbody tr:hover td {
      background: #fbfefc !important;
    }

    input,
    select,
    textarea {
      min-height: 42px;
      background: #fff !important;
      border: 1px solid #dde7e1 !important;
      border-radius: 12px !important;
      font-size: 13px !important;
      transition: 0.15s ease;
    }

    input:focus,
    select:focus,
    textarea:focus {
      outline: none !important;
      border-color: var(--pro-green) !important;
      box-shadow: 0 0 0 4px rgba(32, 184, 116, 0.10) !important;
    }

    button,
    .btn-add,
    .btn-primary {
      min-height: 42px;
      border-radius: 14px !important;
      font-weight: 900 !important;
    }

    .btn-add {
      background: linear-gradient(135deg, #dff57a, #d3ef66) !important;
      color: #172033 !important;
      display: inline-flex;
      align-items: center;
      gap: 8px;
      padding: 10px 16px;
      border: 0;
      transition: 0.16s ease;
      box-shadow: 0 8px 16px rgba(216, 240, 106, 0.22);
    }

    .btn-add:hover {
      filter: brightness(0.98);
      transform: translateY(-1px);
    }

    .icon-btn { border-radius: 12px !important; }

    section,
    .dashboard-section,
    .widget,
    .chart-box {
      border-radius: 22px;
    }

    ::-webkit-scrollbar {
      width: 8px;
      height: 8px;
    }

    ::-webkit-scrollbar-thumb {
      background: #d7e2dc;
      border-radius: 999px;
    }

    ::-webkit-scrollbar-track {
      background: transparent;
    }

    @media (max-width: 1200px) {
      .app-shell,
      html[dir="rtl"] .app-shell,
      html[dir="ltr"] .app-shell,
      html[dir="rtl"] .app-shell.sidebar-collapsed,
      html[dir="ltr"] .app-shell.sidebar-collapsed {
        grid-template-columns: 1fr;
      }

      .pro-sidebar {
        position: static;
        height: auto;
        border: 0;
        border-bottom: 1px solid var(--pro-border);
      }

      html[dir="rtl"] .pro-sidebar {
        grid-column: 1;
        grid-row: 1;
        border-inline-start: 0;
        border-bottom: 1px solid var(--pro-border);
      }

      .pro-main,
      html[dir="rtl"] .pro-main {
        grid-column: 1;
        grid-row: 2;
      }

      .nav-section {
        display: grid;
        grid-template-columns: repeat(3, minmax(0, 1fr));
      }

      .sidebar-footer { display: none; }

      .topbar {
        flex-wrap: wrap;
        height: auto;
      }

      .sidebar-toggle-wrap { display: none; }
    }

    @media (max-width: 700px) {
      .content-wrap {
        padding: 16px 12px 24px;
      }

      .topbar {
        padding: 12px;
      }

      .top-left,
      .top-right {
        width: 100%;
        justify-content: space-between;
      }

      .nav-section {
        grid-template-columns: 1fr 1fr;
      }

      .brand-box {
        justify-content: center;
      }

      .user-info { display: none; }

      .page-title-row h1,
      .content-wrap > h1:first-child {
        font-size: 22px;
      }
    }
  </style>

  {% block head %}{% endblock %}
</head>

<body>
  {% set current_user = request.state.user if request.state.user is defined else None %}
  {% macro L(ar, en) %}{{ ar if lang == 'ar' else en }}{% endmacro %}

  <div id="appShell" class="app-shell">

    <aside class="pro-sidebar">

      <div class="sidebar-toggle-wrap">
        <button type="button" id="sidebarToggleBtn" class="sidebar-float-toggle" title="{{ L('فتح / قفل القائمة', 'Open / close menu') }}">
          <i id="sidebarToggleIcon" class="bi bi-chevron-right"></i>
        </button>
      </div>

      <div class="brand-box">
        <div class="brand-icon">
          <i class="bi bi-airplane-engines"></i>
        </div>
        <div>
          <div class="brand-title">TourismERP</div>
          <div class="brand-sub">{{ L("نظام إدارة سياحة متكامل", "Integrated Tourism Management System") }}</div>
        </div>
      </div>

      <nav class="nav-section">

        <a href="/" class="nav-item {{ 'active' if active == 'home' else '' }}">
          <i class="bi bi-grid-1x2-fill"></i>
          <span>{{ L("الرئيسية", "Dashboard") }}</span>
        </a>

        {% if has_permission(current_user, "reservations.view") %}
        <a href="/reservations" class="nav-item {{ 'active' if active == 'reservations' else '' }}">
          <i class="bi bi-calendar2-check-fill"></i>
          <span>{{ L("الحجوزات", "Reservations") }}</span>
        </a>
        {% endif %}

        {% if has_permission(current_user, "reservations.view") %}
        <a href="/reservations/board" class="nav-item {{ 'active' if active == 'board' else '' }}">
          <i class="bi bi-columns-gap"></i>
          <span>{{ L("لوحة الحجز", "Booking Board") }}</span>
        </a>
        {% endif %}

        <a href="/bookings" class="nav-item {{ 'active' if active == 'bookings' else '' }}">
          <i class="bi bi-bookmark-check-fill"></i>
          <span>{{ L("كل الحجوزات", "All Reservations") }}</span>
        </a>

        <a href="/services" class="nav-item {{ 'active' if active == 'services' else '' }}">
          <i class="bi bi-stars"></i>
          <span>{{ L("الخدمات", "Services") }}</span>
        </a>

        <a href="/hotels" class="nav-item {{ 'active' if active == 'hotels' else '' }}">
          <i class="bi bi-buildings-fill"></i>
          <span>{{ L("الفنادق", "Hotels") }}</span>
        </a>

        {% if has_permission(current_user, "customers.manage") or has_permission(current_user, "customers.view") %}
        <a href="/customers" class="nav-item {{ 'active' if active == 'customers' else '' }}">
          <i class="bi bi-person-fill"></i>
          <span>{{ L("العملاء", "Customers") }}</span>
        </a>
        {% endif %}

        {% if has_permission(current_user, "suppliers.manage") %}
        <a href="/suppliers" class="nav-item {{ 'active' if active == 'suppliers' else '' }}">
          <i class="bi bi-person-plus-fill"></i>
          <span>{{ L("الموردين", "Suppliers") }}</span>
        </a>
        {% endif %}

        {% if has_permission(current_user, "collections.manage") %}
        <a href="/collections" class="nav-item {{ 'active' if active == 'collections' else '' }}">
          <i class="bi bi-cash-coin"></i>
          <span>{{ L("التحصيلات", "Collections") }}</span>
        </a>
        {% endif %}

        {% if has_permission(current_user, "treasury.view") %}
        <a href="/treasury" class="nav-item {{ 'active' if active == 'treasury' else '' }}">
          <i class="bi bi-wallet2"></i>
          <span>{{ L("الخزنة", "Treasury") }}</span>
        </a>
        {% endif %}

        {% if has_permission(current_user, "treasury.view") %}
        <a href="/expenses" class="nav-item {{ 'active' if active == 'expenses' else '' }}">
          <i class="bi bi-receipt"></i>
          <span>{{ L("المصروفات", "Expenses") }}</span>
        </a>
        {% endif %}

        {% if has_permission(current_user, "employees.view") %}
        <a href="/employees" class="nav-item {{ 'active' if active == 'employees' else '' }}">
          <i class="bi bi-people-fill"></i>
          <span>{{ L("الموظفين", "Employees") }}</span>
        </a>
        {% endif %}

        {% if has_permission(current_user, "employees.manage") %}
        <a href="/attendance" class="nav-item {{ 'active' if active == 'attendance' else '' }}">
          <i class="bi bi-calendar-check"></i>
          <span>{{ L("الحضور", "Attendance") }}</span>
        </a>
        {% endif %}

        {% if has_permission(current_user, "payroll.view") %}
        <a href="/payroll" class="nav-item {{ 'active' if active == 'payroll' else '' }}">
          <i class="bi bi-credit-card-2-front"></i>
          <span>{{ L("الرواتب", "Payroll") }}</span>
        </a>
        {% endif %}

        {% if has_permission(current_user, "contracts.view") %}
        <a href="/contracts" class="nav-item {{ 'active' if active == 'contracts' else '' }}">
          <i class="bi bi-file-earmark-text"></i>
          <span>{{ L("العقود", "Contracts") }}</span>
        </a>
        {% endif %}

        {% if has_permission(current_user, "transport.view") %}
        <a href="/transportations" class="nav-item {{ 'active' if active == 'transport' else '' }}">
          <i class="bi bi-truck"></i>
          <span>{{ L("النقل", "Transport") }}</span>
        </a>
        {% endif %}

        {% if has_permission(current_user, "tickets.view") %}
        <a href="/tickets" class="nav-item {{ 'active' if active == 'tickets' else '' }}">
          <i class="bi bi-ticket-perforated"></i>
          <span>{{ L("التذاكر", "Tickets") }}</span>
        </a>
        {% endif %}

        {% if has_permission(current_user, "umrah.view") %}
        <a href="/umrah" class="nav-item {{ 'active' if active == 'umrah' else '' }}">
          <i class="bi bi-globe2"></i>
          <span>{{ L("العمرة", "Umrah") }}</span>
        </a>
        {% endif %}

        {% if has_permission(current_user, "files.view") %}
        <a href="/tourism-files" class="nav-item {{ 'active' if active == 'files' else '' }}">
          <i class="bi bi-folder2-open"></i>
          <span>{{ L("ملفات السياحة", "Tourism Files") }}</span>
        </a>
        {% endif %}

        {% if has_permission(current_user, "police.view") %}
        <a href="/police-notification" class="nav-item {{ 'active' if active == 'police' else '' }}">
          <i class="bi bi-shield-check"></i>
          <span>{{ L("إخطار الشرطة", "Police Notification") }}</span>
        </a>
        {% endif %}

        {% if has_permission(current_user, "reports.view") %}
        <a href="/reports" class="nav-item {{ 'active' if active == 'reports' else '' }}">
          <i class="bi bi-bar-chart-fill"></i>
          <span>{{ L("التقارير", "Reports") }}</span>
        </a>
        {% endif %}

        {% if has_permission(current_user, "collections.manage") %}
        <a href="/suppliers/payments" class="nav-item {{ 'active' if active == 'supplier_payments' else '' }}">
          <i class="bi bi-bank"></i>
          <span>{{ L("سداد الموردين", "Supplier Payments") }}</span>
        </a>
        {% endif %}

        {% if has_permission(current_user, "accounting.manage") %}
        <a href="/accounting/chart" class="nav-item {{ 'active' if active == 'accounting' else '' }}">
          <i class="bi bi-diagram-3"></i>
          <span>{{ L("الحسابات", "Accounting") }}</span>
        </a>
        {% endif %}

        {% if has_permission(current_user, "withdrawals.manage") %}
        <a href="/withdrawals" class="nav-item {{ 'active' if active == 'withdrawals' else '' }}">
          <i class="bi bi-cash"></i>
          <span>{{ L("سحب الموظفين", "Employee Withdrawals") }}</span>
        </a>
        {% endif %}

        {% if has_permission(current_user, "settings.manage") %}
        <a href="/settings" class="nav-item {{ 'active' if active == 'settings' else '' }}">
          <i class="bi bi-gear-fill"></i>
          <span>{{ L("الإعدادات", "Settings") }}</span>
        </a>
        {% endif %}

      </nav>

      <div class="sidebar-footer">
        <strong>Tourism ERP</strong>
        <span>{{ L("نظام إدارة سياحة متكامل للحجوزات، التحصيلات، الفنادق، والخزنة.", "Integrated system for reservations, collections, hotels, and treasury.") }}</span>
      </div>
    </aside>

    <main class="pro-main">
      <header class="topbar">
        <div class="top-left">
          <div class="lang-switch">
            <a href="/set-language/ar" class="{{ 'active' if lang == 'ar' else '' }}">AR</a>
            <a href="/set-language/en" class="{{ 'active' if lang == 'en' else '' }}">EN</a>
          </div>

          <div class="user-chip">
            <div class="user-avatar">
              {%- if current_user -%}
                {%- set _name = current_user.full_name or current_user.username or 'U' -%}
                {%- if lang == 'en' -%}
                  {{ (current_user.username or _name or 'U')[:1] | upper }}
                {%- else -%}
                  {{ _name[:1] }}
                {%- endif -%}
              {%- else -%}U{%- endif -%}
            </div>
            <div class="user-info">
              <div class="user-name">
                {% if current_user and current_user.role == 'owner' %}{{ L('مالك النظام', 'System Owner') }}{% else %}{{ (current_user.full_name or current_user.username) if current_user else L('مستخدم', 'User') }}{% endif %}
              </div>
              <div class="user-role">
                {% if current_user %}
                  {{ L(ROLE_LABELS.get(current_user.role, current_user.role), current_user.role|replace('_', ' ')|title) }}
                {% endif %}
              </div>
            </div>
          </div>

          <a href="/logout" class="logout-btn" title="{{ L('تسجيل الخروج', 'Logout') }}">
            <i class="bi bi-box-arrow-right"></i>
          </a>
        </div>

        <div class="top-right">
          <div class="page-date">
            <i class="bi bi-calendar3"></i>
            {{ today() }}
          </div>
        </div>
      </header>

      <section class="content-wrap">
        {% block content %}{% endblock %}
      </section>
    </main>

  </div>

  <script>
    document.addEventListener('DOMContentLoaded', function () {
      const shell = document.getElementById('appShell');
      const btn = document.getElementById('sidebarToggleBtn');
      const icon = document.getElementById('sidebarToggleIcon');

      if (!shell || !btn) return;

      function updateSidebarIcon() {
        const isCollapsed = shell.classList.contains('sidebar-collapsed');
        const isRtl = document.documentElement.getAttribute('dir') === 'rtl';

        if (!icon) return;

        if (isRtl) {
          icon.className = isCollapsed ? 'bi bi-chevron-left' : 'bi bi-chevron-right';
        } else {
          icon.className = isCollapsed ? 'bi bi-chevron-right' : 'bi bi-chevron-left';
        }
      }

      if (localStorage.getItem('sidebarCollapsed') === '1') {
        shell.classList.add('sidebar-collapsed');
      }

      updateSidebarIcon();

      btn.addEventListener('click', function () {
        shell.classList.toggle('sidebar-collapsed');

        if (shell.classList.contains('sidebar-collapsed')) {
          localStorage.setItem('sidebarCollapsed', '1');
        } else {
          localStorage.removeItem('sidebarCollapsed');
        }

        updateSidebarIcon();
      });
    });
  </script>

  
